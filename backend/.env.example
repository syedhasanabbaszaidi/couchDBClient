# Backend server port
PORT=8001

# Hosted Postgres connection string for leads and usage records
DATABASE_URL=postgres://postgres:postgres@localhost:5432/couchdb_client

# Set to true if your Postgres provider requires SSL
PGSSL=false

# Self-hosted PostHog capture endpoint and project API key
POSTHOG_HOST=http://localhost:8000
POSTHOG_PROJECT_API_KEY=

# GitHub release settings used for DMG/EXE download redirects
RELEASE_TAG=v1.0.0
GITHUB_REPOSITORY=syedhasanabbaszaidi/client
