{
  "name": "couchdb-client",
  "version": "1.0.0",
  "description": "A minimal CouchDB client for managing databases and documents",
  "main": "main.js",
  "author": "https://hasanabbas.in",
  "license": "MIT",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "prepare:frontend": "node scripts/prepare-frontend.js",
    "checksums:release": "node scripts/generate-checksums.js",
    "build:mac": "yarn build:mac:arm64",
    "build:mac:arm64": "yarn prepare:frontend && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "yarn prepare:frontend && electron-builder --mac --x64 --publish never && node scripts/normalize-mac-x64-artifacts.js",
    "build:win": "yarn build:win:x64",
    "build:win:x64": "yarn prepare:frontend && electron-builder --win --x64 --publish never",
    "build:all": "yarn build:release",
    "build:release": "yarn build:mac:arm64 && yarn build:mac:x64 && yarn build:win:x64 && yarn checksums:release"
  },
  "devDependencies": {
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.couchdb.client",
    "productName": "CouchDB Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "local-api.js",
      "package.json",
      "frontend-build/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
