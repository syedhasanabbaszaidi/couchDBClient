{
  "name": "couchdb-client",
  "version": "1.0.0",
  "description": "A minimal CouchDB client for managing databases and documents",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "electron": "^28.1.3"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.couchdb.client",
    "productName": "CouchDB Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "../frontend/build/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg", "zip"],
      "icon": "icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
